{
  "name": "@toc/ai-presentation-agent",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Local presentation agent for RDC, BandMates and AI MCP clients",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "mcp": "node scripts/mcp.mjs",
    "verify": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/verify-live-browser.mjs",
    "test:voice": "node scripts/verify-offline-voice.mjs",
    "test:stream-voice": "node scripts/verify-microphone-stream.mjs",
    "test:browser:mobile": "node scripts/verify-live-browser.mjs --mobile",
    "test:browser:landscape": "node scripts/verify-live-browser.mjs --mobile-landscape",
    "test:browser:tablet": "node scripts/verify-live-browser.mjs --tablet"
  },
  "dependencies": {
    "pptxgenjs": "4.0.1"
  },
  "overrides": {
    "image-size": "2.1.0"
  }
}
